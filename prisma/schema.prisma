generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  completed
  cancelled
}

enum PaymentMethod {
  bank
  whatsapp
}

enum UserRole {
  member
  admin
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  name       String   @default("") @db.VarChar(120)
  phone      String   @default("") @db.VarChar(30)
  address    String   @default("") @db.Text
  city       String   @default("") @db.VarChar(80)
  province   String   @default("") @db.VarChar(80)
  postalCode String   @default("") @map("postal_code") @db.VarChar(12)
  role       UserRole @default(member)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cartItems CartItem[]
  orders    Order[]

  @@index([role])
  @@map("users")
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(200)
  brand       String   @db.VarChar(120)
  brandSlug   String   @map("brand_slug") @db.VarChar(80)
  category    String   @db.VarChar(40)
  subcategory String?  @db.VarChar(40)
  description String   @db.Text
  image       String   @db.VarChar(255)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants  ProductVariant[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([brandSlug])
  @@index([featured])
  @@map("products")
}

model ProductVariant {
  id              Int     @id @default(autoincrement())
  productId       Int     @map("product_id")
  nic             String? @db.VarChar(20)
  stock           Int     @default(0)
  price           Int
  discountPercent Int     @default(0) @map("discount_percent")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  guestId   String?  @map("guest_id") @db.VarChar(64)
  productId Int      @map("product_id")
  variantId Int      @map("variant_id")
  qty       Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@unique([guestId, variantId])
  @@index([userId])
  @@index([guestId])
  @@map("cart_items")
}

model Order {
  id               Int            @id @default(autoincrement())
  code             String         @unique @db.VarChar(32)
  userId           Int            @map("user_id")
  status           OrderStatus    @default(pending_payment)
  paymentMethod    PaymentMethod  @default(bank) @map("payment_method")
  paymentProof     String?        @map("payment_proof") @db.VarChar(255)
  subtotal         Int
  shippingFee      Int            @default(15000) @map("shipping_fee")
  total            Int
  shippingName     String         @map("shipping_name") @db.VarChar(120)
  shippingPhone    String         @map("shipping_phone") @db.VarChar(30)
  shippingAddress  String         @map("shipping_address") @db.Text
  shippingService  String?        @map("shipping_service") @db.VarChar(40)
  shippingEta      String?        @map("shipping_eta") @db.VarChar(40)
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  variantId Int     @map("variant_id")
  name      String  @db.VarChar(200)
  nic       String? @db.VarChar(20)
  image     String  @db.VarChar(255)
  price     Int
  qty       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
