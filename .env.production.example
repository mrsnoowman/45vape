# Salin ke .env di server (jangan commit password asli)

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NAMA_DATABASE"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="USER"
DB_PASSWORD="PASSWORD"
DB_NAME="NAMA_DATABASE"

# Wajib diganti (panjang, acak)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

SHIPPING_FEE="25000"

ADMIN_EMAIL="admin@45vape.com"
ADMIN_PASSWORD="ganti-password-kuat"

# Domain live
NEXT_PUBLIC_SITE_URL="https://45vape.com"

# Port process Node (sesuaikan dengan panel/PM2)
PORT=3000
NODE_ENV=production
